# Скопируйте в .env и заполните. Без SMTP письма сохраняются в папку outbox/
PORT=3000
# Адрес системы — для ссылки «Открыть проект в системе» в письмах
APP_URL=http://localhost:3000
DB_FILE=data/app.db

# Почта (SMTP клиента)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Система контроля производства <notifications@example.ru>

# Как часто проверять просрочки, минут
NOTIFY_INTERVAL_MIN=15

# Необязательно: дублировать уведомления в Telegram-группу
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Только для демонстрации: «сегодняшняя» дата, YYYY-MM-DD
# TODAY=2026-10-22
